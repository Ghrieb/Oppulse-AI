# ---------------------------------------------------------------------------
# Oppulse AI — backend environment
#
# Copy to `.env` and fill in. `.env` is git-ignored: never commit real keys.
# Every setting is optional for local development — the defaults give a
# working, isolated, offline instance (SQLite + replay providers).
#
# Stage 1 (local real loop) fills in the two provider keys and flips the
# two LIVE flags — one at a time, smoke-testing each before the next.
# ---------------------------------------------------------------------------

# -- Stage 1: real AI + real web search -----------------------------------

# Groq key — https://console.groq.com (free tier, no card).
# Powers real model answers once OPPULSE_LIVE_MODEL_PROVIDER=true.
OPPULSE_MODEL_PROVIDER_KEY=

# Tavily key — https://tavily.com (free tier, no card).
# Powers real web research and campus banners/images via the fetcher.
OPPULSE_SEARCH_PROVIDER_KEY=

# Optional second search provider, used when the first spends its quota
# (Exa: https://exa.ai). The run fails honestly rather than silently
# returning nothing if this is also absent.
OPPULSE_FALLBACK_SEARCH_PROVIDER_KEY=

# Flip ONLY after the provider smoke test passes. Each flag is independent:
# capability status reports live/simulated per service from these.
OPPULSE_LIVE_MODEL_PROVIDER=false
OPPULSE_LIVE_SEARCH_PROVIDER=false
OPPULSE_LIVE_EMAIL_PROVIDER=false

# -- Stage 2: database (Supabase) -----------------------------------------

# SQLite is the local default and needs no configuration. For Supabase
# Postgres, set the connection string (service-role / pooled):
#   OPPULSE_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
OPPULSE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.idbucqspftpgfscynozo.supabase.co:5432/postgres

# Private document storage (CVs) via Supabase — signed URLs, never public.
OPPULSE_SUPABASE_URL=https://idbucqspftpgfscynozo.supabase.co
OPPULSE_SUPABASE_SERVICE_ROLE_KEY=

# -- Stage 3: Azure / shared secrets --------------------------------------

# Session signing. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ random bytes) outside `local`; the default is refused at startup.
OPPULSE_JWT_SECRET=

# Environment decides the CORS allowlist: local | staging | production.
# Staging/production require an exact-origin list — no wildcard is possible.
OPPULSE_ENVIRONMENT=local
OPPULSE_CORS_ORIGINS=["http://localhost:5173"]

# Production must use Postgres; SQLite + production is refused at startup.
#   OPPULSE_ENVIRONMENT=production
#   OPPULSE_DATABASE_URL=postgresql+asyncpg://...
