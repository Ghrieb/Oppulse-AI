{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm ci --include=dev",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "OPPULSE_DATABASE_BYPASS": "true",
    "OPPULSE_ACCESS_TOKEN_TTL_SECONDS": "86400",
    "VITE_API_MODE": "live",
    "VITE_GUEST_DEMO": "false",
    "VITE_PRODUCT_MODE": "student_testing",
    "VITE_SHOW_PROTOTYPE_BANNER": "false"
  },
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,frontend/e2e/**,backend/tests/**,backend/scripts/**,archive/**,docs/**,frontend/docs/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/health/ready", "destination": "/api/index.py" }
  ]
}
