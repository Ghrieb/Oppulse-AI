# ---------------------------------------------------------------------------
# Oppulse AI — frontend environment
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# Never commit real keys. Provider secrets belong to the backend only.
# ---------------------------------------------------------------------------

# Origin of the Oppulse AI API, WITHOUT the /api/v1 prefix. The client
# appends /api/v1 itself (see src/lib/api/config.ts buildUrl), so putting
# the version prefix here would produce /api/v1/api/v1 on every request.
# MSW handlers and the HTTP client both read this value, so the two can
# never disagree about where the API lives.
#
# Development:  http://localhost:8000
# Production:   https://<your-api-host>.azurewebsites.net
VITE_API_BASE_URL=http://localhost:8000

# `mock` starts the MSW service worker and serves fixtures from the
# network layer. `live` calls a real backend.
#   VITE_API_MODE=mock
VITE_API_MODE=mock

# Feature flag: show the "prototype data" banner. Automatically enabled
# whenever VITE_API_MODE=mock, but can be forced for screenshots.
VITE_SHOW_PROTOTYPE_BANNER=true

# Product surface. `demo` keeps the synthetic-data disclosure.
# `student_testing` replaces it with per-capability status
# (live / simulated / unavailable) in the app shell.
VITE_PRODUCT_MODE=demo
